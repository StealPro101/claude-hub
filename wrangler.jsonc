{
  // Claude Hub v3 - one Cloudflare Worker: static pages from public/, a small API,
  // GitHub sign-in, and a 15 minute refresh. Free plan, no domain needed.
  // Worker name "hub" + the account subdomain "sp101" gives the address
  //   https://hub.sp101.workers.dev
  // The code never hardcodes that host: it always uses the incoming request's origin,
  // so local runs and tests work the same.
  //
  // NOTHING SECRET LIVES IN THIS FILE. The values below are all public ones.
  // The owner pastes exactly ONE secret into Cloudflare: GITHUB_CLIENT_SECRET.
  // (The session signing key is not a setting at all - the Worker makes its own.)
  "name": "hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",

  // run_worker_first keeps the Worker in front of the static files, so the pages get
  // their security headers and the house games in /games/ get the sandbox header.
  // On an older wrangler the same thing is spelled "experimental_serve_directly": false.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // TO FILL IN: create the namespace (DEPLOY.md step 3) and paste its id here.
  "kv_namespaces": [
    {
      "binding": "HUB",
      "id": "ae805e1965b8452b8d9fd72d694a70e5"
    }
  ],

  // Who is here, who is playing what, and how often a game has been opened. This lives
  // in one Durable Object instead of KV, because presence changes every few seconds and
  // the free KV plan allows about a thousand writes a day. The free plan only offers
  // SQLite-backed Durable Objects, hence new_sqlite_classes.
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Presence"]
    }
  ],

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Plain public settings - never a secret.
  //   GITHUB_CLIENT_ID    TO FILL IN from the GitHub OAuth App (DEPLOY.md step 3).
  //                       A client id is public; only the client secret is a secret.
  //   ADMIN_GITHUB_IDS    numeric GitHub ids that get the admin panel, comma separated.
  //   HUB_OWNER_LOGIN     whose Pages site serves the house games in games/<slug>/
  //   HUB_REPO            this repo's name, used to build that address.
  "vars": {
    "HUB_TOPIC": "claude-hub-game",
    "GITHUB_CLIENT_ID": "Ov23liRj3axxtvvt1dAN",
    "ADMIN_GITHUB_IDS": "256234754",
    "HUB_OWNER_LOGIN": "StealPro101",
    "HUB_REPO": "claude-hub"
  },

  "observability": {
    "enabled": true
  }
}
